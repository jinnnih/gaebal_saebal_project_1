<?xml version="1.0"?>
<!-- ==========================================================================
     valet_car — 차량형(Ackermann) 자율 발렛파킹 로봇
     ROS 2 Jazzy / Gazebo Harmonic / ros2_control(ackermann_steering_controller)

     프레임 규약
       base_footprint  지면 위 차체 중심 투영 (URDF 루트, AMCL base_frame_id)
       base_link       차체 중심, 지면에서 0.33 m (축 평면) — Nav2 robot_base_frame
       base_rear_axle  후륜축 중심. ackermann_steering_controller 의 오도메트리
                       적분 원점이 여기라는 사실을 명시하기 위한 참조 프레임.

     ! base_link 를 후륜축이 아니라 "차체 중심"에 둔 이유
       parking_lot_world 의 nav2_ackermann.yaml footprint 가 [+-2.30, +-1.00] 로
       대칭이고 parking_spots.yaml 의 goal_pose 가 주차면 중심이다. base_link 를
       후륜축에 두면 후진 주차 완료 시 차체가 주차면 밖으로 1.25 m 튀어나온다.

     사용
       xacro valet_car.urdf.xacro sim:=true > valet_car.urdf
     ========================================================================== -->
<robot name="valet_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- true 면 Gazebo 센서 / gz_ros2_control 플러그인을 포함한다.
       false 면 순수 URDF (RViz 로 모델만 확인할 때). -->
  <xacro:arg name="sim" default="true"/>
  <xacro:arg name="controllers_file"
             default="$(find valet_robot)/config/controllers.yaml"/>

  <xacro:include filename="common.xacro"/>
  <xacro:include filename="wheels.xacro"/>

  <!-- ===================== 1. 베이스 ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- 하부 섀시 -->
    <visual>
      <origin xyz="0 0 ${chassis_cz}" rpy="0 0 0"/>
      <geometry><box size="${chassis_len} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="valet_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_cz}" rpy="0 0 0"/>
      <geometry><box size="${chassis_len} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>

    <!-- 상부 데크 — 전장 4.50 x 전폭 1.90 을 정의하는 형상 -->
    <visual>
      <origin xyz="0 0 ${deck_cz}" rpy="0 0 0"/>
      <geometry><box size="${deck_len} ${deck_w} ${deck_h}"/></geometry>
      <material name="valet_deck"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${deck_cz}" rpy="0 0 0"/>
      <geometry><box size="${deck_len} ${deck_w} ${deck_h}"/></geometry>
    </collision>

    <!-- 앞머리 식별 마커 (충돌 없음) -->
    <visual>
      <origin xyz="${deck_len/2.0 - 0.06} 0 ${deck_cz + deck_h/2.0 + 0.02}" rpy="0 0 0"/>
      <geometry><box size="0.12 ${deck_w*0.75} 0.05"/></geometry>
      <material name="valet_front"/>
    </visual>

    <!-- 센서 마스트 (충돌 없음) -->
    <visual>
      <origin xyz="0 0 ${mast_cz}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="valet_metal"/>
    </visual>

    <xacro:box_inertia m="${base_mass}" x="4.50" y="1.60" z="0.60">
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <!-- 후륜축 참조 프레임. ackermann_steering_controller 가 발행하는
       오도메트리(자전거 모델)의 실제 원점. TF 는 여기서 발행하지 않는다. -->
  <link name="base_rear_axle"/>
  <joint name="base_rear_axle_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_rear_axle"/>
    <origin xyz="${-wheelbase/2.0} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 2. 바퀴 ===================== -->
  <xacro:front_corner side="left"  reflect="1"/>
  <xacro:front_corner side="right" reflect="-1"/>
  <xacro:rear_corner  side="left"  reflect="1"/>
  <xacro:rear_corner  side="right" reflect="-1"/>

  <!-- ===================== 3. 센서 프레임 ===================== -->
  <!-- 2D 라이다 — 절대 높이 0.92 m (근거는 common.xacro 주석) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.07"/></geometry>
      <material name="valet_sensor"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 4. 시뮬레이션 ===================== -->
  <xacro:if value="$(arg sim)">
    <xacro:include filename="valet_car.ros2_control.xacro"/>
    <xacro:include filename="sensors.gazebo.xacro"/>
    <xacro:valet_ros2_control controllers_file="$(arg controllers_file)"/>
    <xacro:valet_gazebo/>
  </xacro:if>

</robot>
