<?xml version="1.0"?>
<!-- ==========================================================================
     Gazebo Harmonic 센서 / 플러그인 / 접촉 물성

     발행 토픽 (gz)      -> ros_gz_bridge 로 ROS 2 에 넘어감
       /scan             sensor_msgs/LaserScan   (AMCL, costmap obstacle_layer)
       /imu              sensor_msgs/Imu
       /odom             nav_msgs/Odometry       (odom -> base_footprint)
       /tf_gz            tf2_msgs/TFMessage      (odom -> base_footprint)
     ========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>1.4</mu1>
      <mu2>1.2</mu2>
      <kp>1.0e7</kp>
      <kd>50.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>10.0</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="valet_gazebo">

    <!-- ========== 바퀴 접촉 물성 ========== -->
    <xacro:wheel_surface link="front_left_wheel_link"/>
    <xacro:wheel_surface link="front_right_wheel_link"/>
    <xacro:wheel_surface link="rear_left_wheel_link"/>
    <xacro:wheel_surface link="rear_right_wheel_link"/>

    <!-- ========== 2D 라이다 ==========
         range.max 30.0 = nav2_ackermann.yaml 의 laser_max_range / raytrace_max_range
         range.min 0.20 = laser_min_range -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592</min_angle>
              <max_angle>3.141592</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.012</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ========== IMU ========== -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>

    <!-- ========== 오도메트리 ==========
         ackermann_steering_controller 의 오도메트리는 "후륜축" 기준 자전거 모델이라
         원점이 base_rear_axle 이다. 이 로봇의 base_link 는 차체 중심이므로 컨트롤러
         TF 를 그대로 쓰면 odom->base_footprint 가 1.25 m 어긋난다.
         그래서 컨트롤러는 enable_odom_tf:=false 로 두고(참고용 토픽만 발행),
         odom->base_footprint TF 는 이 플러그인이 base_footprint 기준으로 낸다.
         gaussian_noise 로 누적오차를 만들어 AMCL 이 보정할 여지를 남긴다. -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf_gz</tf_topic>
        <dimensions>2</dimensions>
        <gaussian_noise>0.004</gaussian_noise>
      </plugin>
    </gazebo>

    <!-- 접촉 안정성: 데크/섀시는 자기충돌 비활성 -->
    <gazebo reference="base_link">
      <selfCollide>false</selfCollide>
    </gazebo>

  </xacro:macro>
</robot>
