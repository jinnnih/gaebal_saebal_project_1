{
  "name": "valet-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "차량형 로봇 자율 발렛파킹 — 관제 대시보드 (React + Express + MySQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "mock:ros": "node tools/mock_rosbridge.ts",
    "db:schema": "mysql --defaults-group-suffix=valet < db/schema.sql",
    "db:seed": "node --env-file=.env db/seed.ts",
    "build": "npm run build --workspace=frontend"
  }
}
