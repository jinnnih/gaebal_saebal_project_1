# dashboard/.env 로 복사해서 채운 뒤 사용합니다. .env 는 커밋되지 않습니다.
#
# MySQL 계정은 아래 명령으로 직접 만드세요 (root 비밀번호가 필요합니다).
#
#   mysql -u root -p -e "
#     CREATE DATABASE IF NOT EXISTS valet CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#     CREATE USER IF NOT EXISTS 'valet'@'localhost' IDENTIFIED BY '원하는_비밀번호';
#     GRANT ALL PRIVILEGES ON valet.* TO 'valet'@'localhost';
#     FLUSH PRIVILEGES;"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=valet
DB_PASSWORD=
DB_NAME=valet

# API 서버 포트 (프런트는 5173 에서 뜨고 /api 를 여기로 프록시한다)
PORT=5174
